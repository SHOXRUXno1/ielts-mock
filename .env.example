# Copy to /opt/ielts-mock/.env on the VPS.
# docker-compose.prod.yml reads DB_PASSWORD from here;
# the backend container receives the rest via env_file.

# ── Postgres (compose service `db`) ──────────────────
# Used by docker-compose.prod.yml for POSTGRES_PASSWORD.
DB_PASSWORD=

# ── App ──────────────────────────────────────────────
DEBUG=false

# Host must be `db` (the compose service name), not localhost.
# Password must match DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/ielts_mock

# ── Admin ────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_LOGIN=admin
ADMIN_NAME=Admin

# ── JWT ──────────────────────────────────────────────
# Long random string. Required when DEBUG=false.
SECRET_KEY=

# ── Gemini (LLM evaluation) ──────────────────────────
# Comma-separated keys for rotation.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Groq Whisper (Speech-to-Text) ────────────────────
GROQ_API_KEY=
WHISPER_MAX_CONCURRENT=8

# ── ElevenLabs (Text-to-Speech) ─────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_MAX_CONCURRENT=6

# ── Simli (Video Avatar) ─────────────────────────────
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Simli Pro allows 10 concurrent sessions. Extra students get audio-only.
SIMLI_MAX_CONCURRENT=10
# A session with no turn for this long has lost its browser and stops
# reserving a video slot, instead of holding it until the abandon sweep.
SIMLI_SLOT_IDLE_MINUTES=5
# How long a granted token holds its slot before the exam session takes over.
SIMLI_LEASE_MINUTES=3

# ── Evaluation worker ───────────────────────────────
WORKER_MAX_CONCURRENT_JOBS=4
WORKER_JOB_MAX_RETRIES=3
WORKER_STUCK_PROCESSING_MINUTES=15

# ── S3 (Timeweb) ────────────────────────────────────
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=ielts-mock

# ── CORS ─────────────────────────────────────────────
# JSON array. Must include the public frontend origin.
CORS_ORIGINS=["https://mock.shox-software.uz"]
