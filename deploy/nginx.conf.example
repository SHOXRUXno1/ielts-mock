# Example nginx front for IELTS Mock API + SPA.
# Serve Listening mp3 from disk so FastAPI event loop is not saturated.

upstream ielts_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name exam.example.com;

    client_max_body_size 50m;

    # Static media (audio / uploads) — bypass uvicorn
    location /media/ {
        alias /var/www/ielts-mock/backend/media/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public";
    }

    # API + WebSocket-capable proxy
    location / {
        proxy_pass http://ielts_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://ielts_api/health;
        access_log off;
    }
}
