# ── App ──────────────────────────────────────────────
DEBUG=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ielts_mock

# ── Admin ────────────────────────────────────────────
ADMIN_EMAIL=admin@ielts-mock.com
ADMIN_PASSWORD=changeme

# ── JWT ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Gemini (LLM evaluation) ──────────────────────────
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite
# Transcription is a separate job from marking essays, and not every Gemini
# model accepts an audio request at all. Keep this one on a model that does.
GEMINI_STT_MODEL=gemini-3.5-flash

# ── Google Cloud Speech-to-Text (Chirp, primary) ─────
# One-line service-account JSON. Do not commit the file.
GOOGLE_STT_CREDENTIALS_JSON=
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3
# Temporary: Chirp only. Set false to restore Whisper + Gemini STT.
STT_GOOGLE_ONLY=true

# ── Groq Whisper (Speech-to-Text fallback) ───────────
GROQ_API_KEY=
WHISPER_MAX_CONCURRENT=8

# ── ElevenLabs (Text-to-Speech) ─────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_MAX_CONCURRENT=6

# ── Simli (Video Avatar) ─────────────────────────────
SIMLI_API_KEY=
SIMLI_FACE_ID=
# Simli Pro allows 10 concurrent sessions. Extra students get audio-only.
SIMLI_MAX_CONCURRENT=10
# A session with no turn for this long has lost its browser and stops
# reserving a video slot, instead of holding it until the abandon sweep.
SIMLI_SLOT_IDLE_MINUTES=5
# How long a granted token holds its slot before the exam session takes over.
SIMLI_LEASE_MINUTES=3

# ── Evaluation worker ───────────────────────────────
WORKER_MAX_CONCURRENT_JOBS=4
WORKER_JOB_MAX_RETRIES=3
WORKER_STUCK_PROCESSING_MINUTES=15

# ── DigitalOcean (billing readout on the admin usage page) ─
# Read-only personal access token from cloud.digitalocean.com/account/api.
# Optional: without it the usage page marks DigitalOcean as unconfigured.
DIGITALOCEAN_API_TOKEN=

# Daily Gemini request allowance per key, for the usage page only. Google has
# no quota endpoint, so leave this at 0 unless the tier has a documented daily
# cap — the page then reports calls made rather than a meaningless percentage.
# Free tier is 1500 per key per day.
GEMINI_DAILY_QUOTA_PER_KEY=0

# ── S3 (Timeweb) ────────────────────────────────────
# Leave empty to keep media on the server's own disk under /media.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=ielts-mock

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
